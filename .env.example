# ============================================
# 股票平台 - 环境变量配置
# 复制此文件为 .env 并填入你的配置
# ============================================

# ---------- 运行环境 ----------
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# ---------- 数据库 ----------
# 生产环境建议用 PostgreSQL，本地开发可用 SQLite
# SQLite: sqlite:///app/data/app.db
# PostgreSQL: postgresql://user:pass@host:5432/stock_platform
DATABASE_URL=sqlite:///app/data/app.db

# ---------- 数据服务 ----------
# 数据服务模式: api=仅API, service=仅定时任务, all=全部
DATA_SERVICE_MODE=api

# Tushare Token（用于股票数据获取）
# 注册: https://tushare.pro
TUSHARE_TOKEN=your_tushare_token_here

# Parquet 数据存储目录
PARQUET_DATA_DIR=/app/data/stocks

# ---------- 端口 ----------
HTTP_PORT=80
HTTPS_PORT=443

# ---------- JWT ----------
# JWT 签名密钥（生产环境请务必修改为强随机字符串）
JWT_SECRET=

# ---------- CORS ----------
# 允许的前端域名（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost

# ---------- 数据同步（可选） ----------
SFTP_SYNC_ENABLED=false
# SFTP_HOST=
# SFTP_PORT=22
# SFTP_USERNAME=
# SFTP_PASSWORD=
# SFTP_REMOTE_DATA_DIR=

# ---------- 远端数据服务（可选） ----------
# 如果使用远程数据服务而非本地 data-service
# REMOTE_DATA_SERVICE_URL=http://192.168.3.62:5002
# REMOTE_DATA_SERVICE_TIMEOUT=30
