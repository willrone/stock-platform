[flake8]
# 最大行长度（与black保持一致）
max-line-length = 88
# 最大复杂度
# 先把阈值调到 20，保留真正过重的热点，避免 10 这个过严阈值淹没更高优先级问题。
max-complexity = 20
# 排除的目录和文件
exclude =
    .*,
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .eggs,
    *.egg,
    build,
    dist,
    .mypy_cache,
    .pytest_cache,
    migrations,
    node_modules

# 忽略的错误
ignore =
    # E203: 空格在':'前（与black冲突）
    E203,
    # W503: 行断点前二元运算符（与black冲突）
    W503,
    # E501: 行太长（由max-line-length控制）
    E501,
    # E704: black keeps Protocol stub ellipsis on one line
    E704,
    # E226: 算术运算符周围空格。pycodestyle 自己默认就忽略它；本仓库 select=E 把它打开了，
    # 于是与 black 的运算符空格规则直接打架（例：`r*100`、`amt/1e4`、`lagged[self.lag :]`）。
    # CI 先跑 black --check，再跑 flake8 —— 两者必须能同时为真，否则只能二选一。
    E226

# 选择的错误和警告
select =
    E,  # pycodestyle errors
    W,  # pycodestyle warnings
    F,  # pyflakes
    C,  # mccabe complexity
    B,  # flake8-bugbear
    I   # isort

# 统计信息
statistics = True
count = True

# 按文件忽略
per-file-ignores =
    */__init__.py:F401
    app/api/v1/*.py:B008
    app/api/v1/backtest.py:B008,C901
    app/api/v1/data_impl.py:B008,C901
    app/api/v1/models_impl.py:B008,C901
    app/api/v1/tasks_impl.py:B008,C901
    app/core/error_handler.py:B042,E402
    app/core/errors.py:B042,E402
    app/services/backtest/execution/backtest_executor.py:C901
    app/services/backtest/execution/batch_signal_generator.py:C901
    app/services/backtest/execution/multiprocess_backtest*.py:C901
    app/services/backtest/execution/multiprocess_backtest.py:C901
    app/services/backtest/optimization/portfolio_hyperparameter_optimizer.py:C901
    app/services/backtest/optimization/strategy_hyperparameter_optimizer.py:C901
    app/services/prediction/risk_assessment.py:C901
    app/services/prediction/technical_indicators.py:C901
    app/services/models/model_training.py:C901,E402
    app/services/data/sftp_sync_service.py:E402
    app/services/qlib/enhanced_qlib_provider.py:E402,C901
    app/services/qlib/unified_qlib_training_engine.py:C901
    app/services/qlib/test_alpha158_expression_engine.py:E402
    tests/*.py:E402
    # ── 复杂度债（2026-11-10 登记，不是修好，是「已知的重」）────────────────────────
    # 登记规则：只允许把「已经存在」的函数写在这里；新写的复杂函数必须拆，不许往这里加。
    # 每一笔都是真钱链路上的函数，盲拆会改行为，所以先亮出来再排期重构（台账 §12.85）。
    app/services/backtest/execution/tradability.py:C901
    app/services/backtest/execution/trade_modes.py:C901
    app/services/backtest/strategies/gbm_lab_strategy.py:C901
    app/services/backtest/strategies/gbm_voltgt_strategy.py:C901
    app/services/backtest/strategies/honest_composite_strategy.py:C901
    app/services/backtest/strategies/methods_composite_strategy.py:C901
    app/services/backtest/strategies/regime_switched_strategy.py:C901
    app/services/trading/execution_plan.py:C901
    app/services/trading/multi_asset_service.py:C901
    app/services/trading/signal_service.py:C901
    # E402 例外：official_lgbm_model.py 必须在 import qlib/lightgbm 之前先设 OMP_NUM_THREADS=1，
    # 否则本机 macOS+3.13+libomp 会在 predict 阶段 SIGSEGV（§12.44）——顺序是硬要求，不是风格问题
    app/services/qlib/official_lgbm_model.py:E402
