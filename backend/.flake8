[flake8]
# 最大行长度（与black保持一致）
max-line-length = 88
# 最大复杂度
# 先把阈值调到 20，保留真正过重的热点，避免 10 这个过严阈值淹没更高优先级问题。
max-complexity = 20
# 排除的目录和文件
exclude =
    .*,
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .eggs,
    *.egg,
    build,
    dist,
    .mypy_cache,
    .pytest_cache,
    migrations,
    node_modules

# 忽略的错误
ignore =
    # E203: 空格在':'前（与black冲突）
    E203,
    # W503: 行断点前二元运算符（与black冲突）
    W503,
    # E501: 行太长（由max-line-length控制）
    E501

# 选择的错误和警告
select =
    E,  # pycodestyle errors
    W,  # pycodestyle warnings
    F,  # pyflakes
    C,  # mccabe complexity
    B,  # flake8-bugbear
    I   # isort

# 统计信息
statistics = True
count = True

# 按文件忽略
per-file-ignores =
    */__init__.py:F401
    app/api/v1/*.py:B008
    app/api/v1/data.py:B008,C901
    app/api/v1/models.py:B008,C901
    app/api/v1/tasks.py:B008,C901
    app/core/error_handler.py:B042
    app/core/errors.py:B042
    app/services/backtest/execution/backtest_executor.py:C901
    app/services/backtest/execution/batch_signal_generator.py:C901
    app/services/backtest/execution/multiprocess_backtest*.py:C901
    app/services/backtest/execution/multiprocess_backtest.py:C901
    app/services/backtest/optimization/portfolio_hyperparameter_optimizer.py:C901
    app/services/backtest/optimization/strategy_hyperparameter_optimizer.py:C901
    app/services/prediction/risk_assessment.py:C901
    app/services/prediction/technical_indicators.py:C901
    app/services/models/model_training.py:E402
    app/services/qlib/enhanced_qlib_provider.py:E402,C901
    app/services/qlib/unified_qlib_training_engine.py:C901
    app/services/qlib/test_alpha158_expression_engine.py:E402
    tests/*.py:E402
